<?xml version="1.0"?>

	<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="imdbgraphqlphp" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">

	<description>PSR-12</description>

	<file>src/Imdb</file>

	<arg name="basepath" value="./"/>
	<!--<arg name="colors"/>-->
	<arg value="ps"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="warning-severity" value="1"/>

	<rule ref="PSR12">
		<exclude name="Generic.Files.LineLength.TooLong"/>
	</rule>
</ruleset>
